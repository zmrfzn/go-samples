{
  "name": "Prebuilt Go Debian Slim",
  "image": "ghcr.io/devcontainers/images/go:1-bookworm",

  // Customizations for VS Code inside the Codespace
  "customizations": {
    "vscode": {
      // Essential settings for the Go extension
      "settings": {
        "go.toolsManagement.checkForUpdates": "local",
        "go.useLanguageServer": true,
        "gopls": {
          "ui.semanticTokens": true
        }
      },
      // Automatically installs the official Go extension upon launch
      "extensions": [
        "golang.go"
      ]
    }
  },

  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  // "forwardPorts": [8080],

  // Ensures your terminal runs as a non-root user for security and file permission sanity
  "remoteUser": "vscode"
}
